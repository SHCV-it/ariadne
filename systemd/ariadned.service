[Unit]
Description=Ariadne terminal completion daemon
Documentation=man:ariadne(1)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ariadned
Restart=on-failure
RestartSec=2

# systemd's default PATH omits ~/.local/bin, where this project installs its
# own binaries (and where many user tools live). The daemon's tool-presence
# feature and the harvest PATH scan both use this PATH, so without it every
# candidate whose binary sits in ~/.local/bin (herdr, …) silently loses the
# tool_present boost and never gets a tool spec harvested.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.local/kitty.app/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/opt/cuda/bin:/usr/lib/jvm/default/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl

# The daemon holds your shell history. Confine it accordingly. These also
# provide the process sandbox the harvester needs when it shells out to
# systemd-run for --help scraping.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# StateDirectory both creates the data dir on first install and whitelists it
# for writing; ReadWritePaths alone fails namespace setup when it is missing.
StateDirectory=ariadne
ReadWritePaths=%h/.local/share/ariadne
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M

[Install]
WantedBy=default.target
